{
  "name": "@relay/desktop",
  "productName": "Relay",
  "version": "0.2.0",
  "description": "Relay, the migration assistant",
  "author": "Relay",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "shell": "bun build ./electron/main.ts ./electron/preload.ts --outdir dist-electron --entry-naming [name].cjs --target node --format cjs --external=electron --external=@napi-rs/keyring --external=electron-updater",
    "app": "bun scripts/app.ts",
    "package": "bun run build && bun run shell && electron-builder --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@relay/ui": "workspace:*",
    "@supabase/auth-js": "^2.117.3",
    "@supabase/postgrest-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/bstcoc/relay"
}
